classDiagram
  direction TB
  class Usuario {
    -int id
    -string nome
    -string email
    -string senhaHash
    -string telefone
    -string perfil
    -bool ativo
    +entrar()
    +sair()
    +criarConta()
  }
  class Cliente {
    +fazerPedido()
    +pagar()
    +acompanhar()
    +avaliarProduto()
    +avaliarEntrega()
  }
  class Barista {
    +iniciarPreparo()
    +marcarPronto()
  }
  class Entregador {
    +iniciarEntrega()
    +confirmarEntrega()
  }
  class Gerente {
    +atribuirEntregador()
    +gerenciarProdutos()
    +gerenciarUsuarios()
    +emitirRelatorios()
  }
  class Administrador {
    +baixarBackup()
  }
  class Endereco {
    -string cep
    -string logradouro
    -string numero
    -string bairro
    -string cidade
    -string uf
    -string instrucoes
  }
  class Categoria {
    -string nome
  }
  class Produto {
    -string nome
    -string origemGrao
    -int intensidade
    -decimal preco
    -decimal precoPromocional
    -int estoque
    -bool ativo
    +precoFinal()
  }
  class Carrinho {
    -itens
    +adicionar()
    +atualizar()
    +remover()
    +limpar()
    +resumo()
  }
  class Pedido {
    -string tipoEntrega
    -datetime dataAgendada
    -string status
    -decimal subtotal
    -decimal taxaEntrega
    -decimal total
    +criar()
    +mudarStatus()
  }
  class ItemPedido {
    -int quantidade
    -decimal precoUnitario
    -string tipoLeite
    -string acucar
    -string intensidade
  }
  class Pagamento {
    -string metodo
    -string status
    -decimal valor
    -string cartaoUltimos4
    +aprovar()
  }
  class Entrega {
    -string status
    -datetime atribuidoEm
    -datetime entregueEm
    -int notaCliente
    +atribuir()
  }
  class Avaliacao {
    -int nota
    -string comentario
  }
  class Notificacao {
    -string mensagem
    -bool lida
    +criar()
  }
  class PedidoFavorito {
    -string nome
    -int quantidade
  }
  class Insumo {
    -string nome
    -decimal quantidade
    -decimal minimo
  }
  Usuario <|-- Cliente
  Usuario <|-- Barista
  Usuario <|-- Entregador
  Usuario <|-- Gerente
  Gerente <|-- Administrador
  Cliente "1" --> "0..*" Endereco : possui
  Cliente "1" --> "0..*" Pedido : realiza
  Cliente "1" --> "0..*" Avaliacao : escreve
  Cliente "1" --> "0..*" PedidoFavorito : salva
  Usuario "1" --> "0..*" Notificacao : recebe
  Categoria "1" --> "0..*" Produto : classifica
  Produto "1" --> "0..*" Avaliacao : recebe
  Pedido "1" *-- "1..*" ItemPedido : contem
  ItemPedido "0..*" --> "1" Produto : refere
  Pedido "1" *-- "0..1" Pagamento : pago por
  Pedido "1" *-- "0..1" Entrega : gera
  Pedido "0..*" --> "1" Endereco : destino
  Entregador "1" --> "0..*" Entrega : realiza
  Carrinho ..> Produto : consulta
